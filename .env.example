# Firebase Web App (Project settings → Your apps → SDK setup → Config).
# Copy to `.env.local` (gitignored) for local dev / production builds.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Firebase + Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# Callable / HTTPS Cloud Functions region (default SDK region if unset).
# VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# API origin: leave empty for same-origin `/api` (Vite dev proxy).
# VITE_API_BASE=https://api.example.com

# Slow / unstable networks (e.g. mobile data): give bootstrap more time before "System offline".
# Soft mode keeps desks writable when /api/livez still answers; hard lock only when the API is unreachable.
# Defaults: 90000 ms timeout, tolerate 5 failed polls, poll every 60000 ms.
# VITE_BOOTSTRAP_TIMEOUT_MS=120000
# VITE_POLL_FAILURE_TOLERANCE=8
# VITE_WORKSPACE_POLL_MS=90000

# Online Office Desk v2 at / (set 0 to use legacy Gmail-style workspace UI).
# VITE_OFFICE_DESK_V2=1

# Workspace V3 (Teams-style Chat shell) — on by default.
# Set to 0 only to fall back to Office Desk V2 / legacy.
# VITE_WORKSPACE_V3=0

# --- Local Firebase emulators (`firebase emulators:start`) ---
# VITE_FIREBASE_USE_EMULATORS=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
